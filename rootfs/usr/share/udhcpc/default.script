#!/bin/sh
# BusyBox udhcpc default script for MicroOS

[ -z "$1" ] && echo "Error: should be called from udhcpc" && exit 1

RESOLV_CONF="/etc/resolv.conf"
[ -e "$RESOLV_CONF" ] || touch "$RESOLV_CONF"

case "$1" in
    deconfig)
        /sbin/ifconfig "$interface" 0.0.0.0 2>/dev/null || true
        ;;
    renew|bound)
        /sbin/ifconfig "$interface" "$ip" netmask "${subnet:-255.255.255.0}" broadcast "${broadcast:-+}" up 2>/dev/null || true

        if [ -n "$router" ]; then
            while /sbin/route del default gw 0.0.0.0 dev "$interface" 2>/dev/null; do
                :
            done
            for r in $router; do
                /sbin/route add default gw "$r" dev "$interface" 2>/dev/null || true
            done
        fi

        echo -n > "$RESOLV_CONF"
        [ -n "$domain" ] && echo "search $domain" >> "$RESOLV_CONF"
        for i in $dns; do
            echo "nameserver $i" >> "$RESOLV_CONF"
        done
        # Fallback nameservers
        echo "nameserver 10.0.2.3" >> "$RESOLV_CONF"
        echo "nameserver 8.8.8.8" >> "$RESOLV_CONF"
        echo "nameserver 1.1.1.1" >> "$RESOLV_CONF"
        ;;
esac

exit 0
