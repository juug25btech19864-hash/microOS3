# ~/.shinit for user srivas
export PATH="/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin:/usr/games"
export ENV="/etc/shinit"

whoami() {
    echo "srivas"
}
who() {
    if [ "$1" = "am" ] && [ "$2" = "i" ]; then
        echo "srivas"
    else
        echo "srivas    tty1         $(date 2>/dev/null)"
    fi
}

help() {
    /usr/bin/help "$@"
}

alias help='/usr/bin/help'
alias commands='/usr/bin/help'
alias '?'='/usr/bin/help'
alias cls='clear'
alias ll='ls -la'
alias la='ls -A'
alias l='ls -CF'
alias info='uname -a'
alias netinfo='ifconfig'
alias restart='reboot'
alias shutdown='poweroff'
alias gui='desktop'
