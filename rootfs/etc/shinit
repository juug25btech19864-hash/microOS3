# /etc/shinit for MicroOS interactive shell
unalias help ping q quit heip 2>/dev/null || true

whoami() {
    echo "srivas"
}
who() {
    if [ "$1" = "am" ] && [ "$2" = "i" ]; then
        echo "srivas"
    else
        echo "srivas    tty1         $(date 2>/dev/null)"
    fi
}

help() {
    /usr/bin/help "$@"
}

ping() {
    /usr/bin/ping "$@"
}

q() {
    exit 0
}
quit() {
    exit 0
}
heip() {
    /usr/bin/help "$@"
}
deskstop() {
    /usr/bin/desktop "$@"
}

alias ping='/usr/bin/ping'
alias help='/usr/bin/help'
alias heip='/usr/bin/help'
alias hlep='/usr/bin/help'
alias hlpe='/usr/bin/help'
alias halp='/usr/bin/help'
alias deskstop='desktop'
alias commands='/usr/bin/help'
alias '?'='/usr/bin/help'
alias cls='clear'
alias ll='ls -la'
alias la='ls -A'
alias l='ls -CF'
alias info='uname -a'
alias netinfo='ifconfig'
alias restart='reboot'
alias shutdown='poweroff'
alias gui='desktop'
alias q='exit'
alias quit='exit'
alias :q='exit'
